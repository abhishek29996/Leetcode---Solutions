from collections import deque

class Solution:
    def isSameTree(self, p: Optional[TreeNode], q: Optional[TreeNode]) -> bool:
        ## DFS solution
        if not q and not p :
            return True

        if not q or not p :
            return False

        if q.val != p.val :
            return False

        return (self.isSameTree(q.left , p.left)
        and self.isSameTree(q.right , p.right))

