class Solution:
    def floodFill(self, image: List[List[int]], sr: int, sc: int, color: int) -> List[List[int]]:

        ### DFS Solution
        row = len(image)
        col = len(image[0])

        original = image[sr][sc]

        if original == color:
            return image

        def dfs(r, c):
            if r < 0 or r >= row or c < 0 or c >= col:
                return

            if image[r][c] != original:
                return

            image[r][c] = color

            dfs(r + 1, c)  ## down
            dfs(r - 1, c)  ## up
            dfs(r, c + 1)  ## right
            dfs(r, c - 1)  ## left

        dfs(sr, sc)

        return image
