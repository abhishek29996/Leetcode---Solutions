class Solution:
    def firstUniqChar(self, s: str) -> int:

        freq = {}

        for j in s:
            if j in freq:
                freq[j] += 1
            else:
                freq[j] = 1

        for i, ch in enumerate(s):  ### O(1) complexity
            if freq[ch] == 1:
                return i
                break

        return -1

