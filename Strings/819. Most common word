class Solution:
    def mostCommonWord(self, paragraph: str, banned: List[str]) -> str:

        freq = {}
        banned = set(banned)
        res = re.findall(r"[a-zA-Z]+", paragraph.lower())

        for word in res :
            word = word.lower().strip(".,!?")

            if word not in banned :

                # freq[word] = freq.get(word,0) + 1
                # OR
                if word in freq :
                    freq[word] += 1
                else :
                    freq[word] = 1

        max_val = 0
        word = ""

        for key , val in freq.items() :

            if val > max_val :
                max_val = val
                word = key
        return word
