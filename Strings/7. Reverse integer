class Solution:
    def reverse(self, x: int) -> int:

        sign = -1 if x < 0 else 1    #### 1st Soltion
        x = abs(x)
        rev = 0

        while x :
            digit = x % 10
            rev = rev*10 + digit
            x = x //10

        rev = int(rev) * sign

        if rev < -(2**31) or rev > (2**31 - 1):
            return 0

        return rev

