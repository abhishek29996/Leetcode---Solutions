from collections import Counter


def check_inclusion(s1: str, s2: str) -> bool:
    l1 = len(s1)
    l2 = len(s2)

    if l1 > l2:
        return False

    target = Counter(s1)
    window = Counter(s2[:l1])

    if target == window:
        return True

    for j in range(l1, l2):
        window[s2[j]] += 1

        left_char = s2[j - l1]
        window[left_char] -= 1

        if window[left_char] == 0:
            del window[left_char]

        if target == window:
            return True

    return False


# Example
s1 = "ab"
s2 = "eidbaooo"

print(check_inclusion(s1, s2))
