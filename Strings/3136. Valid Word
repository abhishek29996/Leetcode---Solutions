class Solution:
    def isValid(self, word: str) -> bool:
        vowel = 0
        consonant = 0

        if len(word) < 3 :
            return False

        for j in word :
            if not j.isalnum():
                return False

            if j.isalpha():
                if j.upper() in "AEIOU" :
                    vowel += 1
                else :
                    consonant += 1
         return vowel > 0 and consonant > 0 
