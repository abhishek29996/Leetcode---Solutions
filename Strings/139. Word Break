class Solution:
    def wordBreak(self, s: str, wordDict: List[str]) -> bool:

        ## Dynamic Programming Technique
        n = len(s)
        DP = [False] * (n + 1)
        DP[0] = True
        w_set = set(wordDict)

        for i in range(1, len(s) + 1):
            for j in range(i):
                if DP[j] and s[j:i] in w_set:
                    DP[i] = True
                    break

        return DP[n]
