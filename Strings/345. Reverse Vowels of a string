class Solution:
    def reverseVowels(self, s: str) -> str:
        res = list(s)
        left = 0
        right = len(res) - 1

        while left < right:

            while left < right and res[left].upper() not in "AEIOU":
                left += 1

            while left < right and res[right].upper() not in "AEIOU":
                right -= 1

            res[left], res[right] = res[right], res[left]

            left += 1
            right -= 1

        return "".join(res)
