from collections import deque

class Solution:
    def check(self, nums: List[int]) -> bool:
        
        list1 = nums[:]
        list1.sort()
        q = deque(list1)
        
        if list1 == nums:
            return True
            
        for j in range(len(nums)):
            
            if list(q) == nums:
                return True
                
            q.append(q.popleft())
            
        return False
