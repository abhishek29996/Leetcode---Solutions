from collections import deque

class Solution:
    def rotateString(self, s: str, goal: str) -> bool:
        q = deque(s)

        if len(s) != len(goal):
            return False

        for j in range(len(s)):
            if s == goal:
                return True

            if "".join(q) == goal:
                return True

            q.append(q.popleft())

        return False
