from typing import List

# DP / Optimized Solution (Frequency Array)
class SolutionDP:
    def findDisappearedNumbers(self, nums: List[int]) -> List[int]:
        n = len(nums)
        counts = [0] * (n + 1)
        for num in nums:
            counts[num] = 1
        return [i for i in range(1, n + 1) if counts[i] < 1]


# Brute Force / Hash Set Solution (Using List Comprehension)
class SolutionBruteForce:
    def findDisappearedNumbers(self, nums: List[int]) -> List[int]:
        sets = set(nums)
        return [j for j in range(1, len(nums) + 1) if j not in sets]
