class Solution:
    def luckyNumbers(self, matrix: List[List[int]]) -> List[int]:

        rows = len(matrix)

        for r in range(rows) :
            row_min = min(matrix[r])
            col_idx = matrix[r].index(row_min)

            is_col_max = True

            for r in range(rows) :
                if matrix[r][col_idx] > row_min :
                    is_col_max = False
                    break
            if is_col_max :
                return [row_min]

        return []
