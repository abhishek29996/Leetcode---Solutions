class Solution:
    def threeSumClosest(self, nums: List[int], target: int) -> int:

        nums.sort()
        closest = nums[0] + nums[1] + nums[2]

        for i in range(len(nums)):

            left = i + 1
            right = len(nums) - 1

            while left < right :

                summ = nums[i] + nums[left] + nums[right]

                if abs(target - summ) < abs(target - closest):
                    closest = summ

                if summ < target :
                    left += 1
                elif summ > target :
                    right -= 1

                else :
                    return summ
                    left += 1
                    right -= 1

        return closest
